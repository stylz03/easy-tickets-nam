# Copy to .env.local and fill in. ALL of these are server-only.
# Never prefix secrets with NEXT_PUBLIC_ (that would ship them to the browser).

# DPO Pay (3G Direct Pay) – from the DPO onboarding email/PDF
DPO_COMPANY_TOKEN=your-dpo-company-token
DPO_SERVICE_TYPE=3854
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv2.php?ID=
DPO_CURRENCY=NAD
# Payment time limit for the DPO token (default unit: hours; set DPO_PTL_TYPE=minutes to change)
DPO_PTL=30
# DPO_PTL_TYPE=hours

# HMAC secret used to sign order/receipt tokens (min 32 chars).
# Generate with: openssl rand -base64 48
ORDER_SIGNING_SECRET=change-me-to-a-long-random-string

# Public base URL used for DPO RedirectURL/BackURL. Optional: if unset, the
# request host (or VERCEL_URL) is used. Not a secret.
# NEXT_PUBLIC_SITE_URL=https://easy-tickets-nam.vercel.app
